{
	"manifest_version": 3,
	"name": "Росдистант Помощник — учебники в PDF",
	"short_name": "Росдистант Помощник",
	"description": "Скачивайте учебники, конспекты iSpring и результаты тестов из Росдистанта в PDF и HTML — в один клик, офлайн.",
	"version": "1.6.2",
	"icons": {
		"16": "icons/16.png",
		"32": "icons/32.png",
		"48": "icons/48.png",
		"128": "icons/128.png"
	},
	"action": {
		"default_popup": "popup.html",
		"default_title": "Росдистант Помощник"
	},
	"permissions": ["scripting", "activeTab", "downloads", "storage", "clipboardWrite"],
	"host_permissions": [
		"https://*.rosdistant.ru/*",
		"https://edu.rosdistant.ru/*"
	],
	"background": {
		"scripts": ["background.js"]
	},
	"web_accessible_resources": [
		{
			"resources": ["lib/pdf.worker.min.js", "lib/qpdf.wasm"],
			"matches": ["https://*.rosdistant.ru/*"]
		}
	],
	"browser_specific_settings": {
		"gecko": {
			"id": "rosdistant-helper@opiums.helper",
			"strict_min_version": "115.0"
		}
	}
}
